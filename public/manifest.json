{
  "$schema": "../node_modules/@lobehub/chat-plugin-sdk/schema.json",
  "api": [
    {
      "name": "CodeExecutor",
      "url": "https://codeexec-plugin.vercel.app/api/v2",
      "description": "运行并执行各种编程语言的代码",
      "parameters": {
        "properties": {
          "language": {
            "description": "编程语言，例如：python, java, javascript",
            "type": "string"
          },
          "stdin": {
            "description": "标准输入数据（可选）",
            "type": "string"
          },
          "files": {
            "description": "包含代码的文件数组",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "文件名",
                  "type": "string"
                },
                "content": {
                  "description": "文件内容",
                  "type": "string"
                }
              },
              "required": ["name", "content"]
            }
          }
        },
        "required": ["language", "files"],
        "type": "object"
      }
    }
  ],
  "settings": {
    "type": "object",
    "required": ["RAPIDAPI_KEY"],
    "properties": {
      "RAPIDAPI_KEY": {
        "title": "RapidAPI Key",
        "description": "我们使用 [OneCompiler API](https://rapidapi.com/onecompiler-onecompiler-default/api/onecompiler-apis) 作为后端服务 | We use OneCompiler API as the backend service",
        "type": "string",
        "format": "password"
      }
    }
  },
  "ui": {
    "url": "https://codeexec-plugin.vercel.app/ui",
    "height": 400
  },
  "author": "ZWL_FineHow",
  "createdAt": "2024-11-21",
  "homepage": "https://github.com/FineHow/CodeExec-Plugin",
  "identifier": "CodeExecutor",
  "meta": {
    "avatar": "💻",
    "tags": ["CodeExecution"],
    "title": "代码执行器",
    "description": "运行并执行各种编程语言的代码"
  },
  "version": "1"
}
